<!--
  The CrewOps Agent, behind the table: suggested questions for the disruption being worked,
  voice where the browser can hear, and the verified answer.
-->
<style>
  .root {
    flex-direction: column;
    padding-top: 1.6;
    padding-bottom: 1.6;
    padding-left: 1.7;
    padding-right: 1.7;
    gap: 0.7;
    background-color: #0a1222;
    border-color: #1f3b63;
    border-width: 0.12;
    border-radius: 2.4;
  }
  .header { flex-direction: row; align-items: center; gap: 0.8; }
  .badge {
    width: 3.2;
    height: 3.2;
    border-radius: 1;
    background-color: #0c2a4a;
    align-items: center;
    justify-content: center;
  }
  .badge-icon { width: 1.8; height: 1.8; color: #38bdf8; }
  .heading { flex-direction: column; gap: 0.15; }
  .eyebrow { font-size: 0.95; font-weight: 700; color: #38bdf8; }
  .title { font-size: 1.9; font-weight: 700; color: #f1f5f9; }
  .muted { font-size: 1.0; color: #8ea3bf; }
  .divider { height: 0.08; background-color: #1f3b63; margin-top: 0.3; margin-bottom: 0.3; }
  .label { font-size: 0.9; font-weight: 700; color: #64748b; }
  .button {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-top: 0.75;
    padding-bottom: 0.75;
    padding-left: 1.3;
    padding-right: 1.3;
    border-radius: 1.2;
    background-color: #16294a;
    cursor: pointer;
  }
  .button:hover { background-color: #1f3b63; }
  .button-text { font-size: 1.15; font-weight: 600; color: #e2e8f0; }
  .button-icon { width: 1.4; height: 1.4; color: #e2e8f0; }

  .root { width: 54; gap: 0.8; }
  .questions { flex-direction: row; gap: 0.7; flex-wrap: wrap; }
  .question {
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.0;
    padding-right: 1.0;
    border-radius: 1.0;
    background-color: #0f1b31;
    border-color: #1f3b63;
    border-width: 0.1;
    cursor: pointer;
  }
  .question:hover { background-color: #16294a; border-color: #38bdf8; }
  .question-text { font-size: 1.05; color: #e2e8f0; }
  .answer { font-size: 1.25; color: #f1f5f9; }
  .answer-meta { flex-direction: row; align-items: center; gap: 0.5; }
  .verified-icon { width: 1.3; height: 1.3; color: #22c55e; }
  .verified { font-size: 0.95; font-weight: 700; color: #22c55e; }
  .mic { background-color: #7c3aed; }
  .mic:hover { background-color: #8b5cf6; }
</style>
<div class="root">
  <div class="header">
    <div class="badge"><Bot class="badge-icon"></Bot></div>
    <div class="heading">
      <div class="eyebrow">CREWOPS AGENT</div>
      <div id="agent-title" class="title">Ask about this disruption</div>
    </div>
  </div>
  <div class="questions">
    <button id="q-0" class="question"><div id="q-0-text" class="question-text">Question</div></button>
    <button id="q-1" class="question"><div id="q-1-text" class="question-text">Question</div></button>
    <button id="q-2" class="question"><div id="q-2-text" class="question-text">Question</div></button>
    <button id="mic-button" class="button mic"><Mic class="button-icon"></Mic><div id="mic-text" class="button-text">Ask by voice</div></button>
  </div>
  <div id="answer-text" class="answer">Every figure in an answer comes from the legality engine and is checked before it is spoken.</div>
  <div id="answer-meta" class="answer-meta">
    <BadgeCheck class="verified-icon"></BadgeCheck>
    <div class="verified">VERIFIED AGAINST THE ENGINE</div>
  </div>
</div>
