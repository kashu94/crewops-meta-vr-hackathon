<!--
  A disruption drill: the clock, how many seats are covered, one line per seat with what it
  cost against the engine's cheapest legal cover, and at the end the score and the best so far.
-->
<style>
  .root {
    flex-direction: column;
    padding-top: 1.6;
    padding-bottom: 1.6;
    padding-left: 1.7;
    padding-right: 1.7;
    gap: 0.7;
    background-color: #0a1222;
    border-color: #1f3b63;
    border-width: 0.12;
    border-radius: 2.4;
  }
  .header { flex-direction: row; align-items: center; gap: 0.8; }
  .badge {
    width: 3.2;
    height: 3.2;
    border-radius: 1;
    background-color: #0c2a4a;
    align-items: center;
    justify-content: center;
  }
  .badge-icon { width: 1.8; height: 1.8; color: #38bdf8; }
  .heading { flex-direction: column; gap: 0.15; }
  .eyebrow { font-size: 0.95; font-weight: 700; color: #38bdf8; }
  .title { font-size: 1.9; font-weight: 700; color: #f1f5f9; }
  .muted { font-size: 1.0; color: #8ea3bf; }
  .divider { height: 0.08; background-color: #1f3b63; margin-top: 0.3; margin-bottom: 0.3; }
  .label { font-size: 0.9; font-weight: 700; color: #64748b; }
  .button {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-top: 0.75;
    padding-bottom: 0.75;
    padding-left: 1.3;
    padding-right: 1.3;
    border-radius: 1.2;
    background-color: #16294a;
    cursor: pointer;
  }
  .button:hover { background-color: #1f3b63; }
  .button-text { font-size: 1.15; font-weight: 600; color: #e2e8f0; }
  .button-icon { width: 1.4; height: 1.4; color: #e2e8f0; }

  .root { width: 46; gap: 0.75; }
  .clock-row { flex-direction: row; align-items: center; gap: 1.2; }
  .clock { font-size: 3.2; font-weight: 800; color: #f1f5f9; }
  .progress { font-size: 1.2; font-weight: 600; color: #8ea3bf; }
  .result {
    flex-direction: row;
    align-items: center;
    gap: 0.8;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 0.8;
    padding-right: 0.8;
    border-radius: 1;
    background-color: #0f1b31;
  }
  .mark {
    font-size: 0.85;
    font-weight: 800;
    color: #052e16;
    background-color: #22c55e;
    padding-top: 0.12;
    padding-bottom: 0.12;
    padding-left: 0.45;
    padding-right: 0.45;
    border-radius: 0.5;
  }
  .result-text { font-size: 1.05; color: #e2e8f0; flex-grow: 1; }
  .points { font-size: 1.15; font-weight: 800; color: #38bdf8; }
  .score-row { flex-direction: row; align-items: center; gap: 1.2; }
  .score { font-size: 2.6; font-weight: 800; color: #22c55e; }
  .grade {
    font-size: 2.0;
    font-weight: 800;
    color: #0a1222;
    background-color: #22c55e;
    padding-top: 0.3;
    padding-bottom: 0.3;
    padding-left: 1.0;
    padding-right: 1.0;
    border-radius: 1;
  }
  .best { font-size: 1.1; color: #8ea3bf; }
  .rules { font-size: 0.95; color: #64748b; }
  .actions { flex-direction: row; gap: 0.7; }
  .primary { background-color: #7c3aed; }
  .primary:hover { background-color: #8b5cf6; }
</style>
<div class="root">
  <div class="header">
    <div class="badge"><Gauge class="badge-icon"></Gauge></div>
    <div class="heading">
      <div class="eyebrow">DISRUPTION DRILL  |  TRAINING COPY, NOT THE LIVE ROSTER</div>
      <div id="drill-title" class="title">Cover every seat</div>
    </div>
  </div>
  <div class="clock-row">
    <div id="drill-clock" class="clock">00:00</div>
    <div id="drill-progress" class="progress">0 of 3 covered</div>
  </div>
  <div id="r-0" class="result">
    <div id="r-0-mark" class="mark">OK</div>
    <div id="r-0-text" class="result-text">P-0000</div>
    <div id="r-0-points" class="points">300</div>
  </div>
  <div id="r-1" class="result">
    <div id="r-1-mark" class="mark">OK</div>
    <div id="r-1-text" class="result-text">P-0000</div>
    <div id="r-1-points" class="points">300</div>
  </div>
  <div id="r-2" class="result">
    <div id="r-2-mark" class="mark">OK</div>
    <div id="r-2-text" class="result-text">P-0000</div>
    <div id="r-2-points" class="points">300</div>
  </div>
  <div id="r-3" class="result">
    <div id="r-3-mark" class="mark">OK</div>
    <div id="r-3-text" class="result-text">P-0000</div>
    <div id="r-3-points" class="points">300</div>
  </div>
  <div id="drill-score-row" class="score-row">
    <div id="drill-score" class="score">0 / 100</div>
    <div id="drill-grade" class="grade">A</div>
    <div id="drill-best" class="best">Best on this device: -</div>
  </div>
  <div id="drill-rules" class="rules">300 points a seat: less 3 for each % over the cheapest legal cover, 40 for each crew member offered who was not legal, and 1 for each second past 45.</div>
  <div class="actions">
    <button id="drill-again" class="button primary"><RotateCcw class="button-icon"></RotateCcw><div class="button-text">Run it again</div></button>
    <button id="drill-exit" class="button"><div id="drill-exit-text" class="button-text">Back to the desk</div></button>
  </div>
</div>
