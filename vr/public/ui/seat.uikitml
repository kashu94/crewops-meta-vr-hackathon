<!--
  The seat being covered: the trip and what it puts at risk, the engine's recommendation,
  the verdict on the card over the seat (every rule with its margin), and submit.
-->
<style>
  .root {
    flex-direction: column;
    padding-top: 1.6;
    padding-bottom: 1.6;
    padding-left: 1.7;
    padding-right: 1.7;
    gap: 0.7;
    background-color: #0a1222;
    border-color: #1f3b63;
    border-width: 0.12;
    border-radius: 2.4;
  }
  .header { flex-direction: row; align-items: center; gap: 0.8; }
  .badge {
    width: 3.2;
    height: 3.2;
    border-radius: 1;
    background-color: #0c2a4a;
    align-items: center;
    justify-content: center;
  }
  .badge-icon { width: 1.8; height: 1.8; color: #38bdf8; }
  .heading { flex-direction: column; gap: 0.15; }
  .eyebrow { font-size: 0.95; font-weight: 700; color: #38bdf8; }
  .title { font-size: 1.9; font-weight: 700; color: #f1f5f9; }
  .muted { font-size: 1.0; color: #8ea3bf; }
  .divider { height: 0.08; background-color: #1f3b63; margin-top: 0.3; margin-bottom: 0.3; }
  .label { font-size: 0.9; font-weight: 700; color: #64748b; }
  .button {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-top: 0.75;
    padding-bottom: 0.75;
    padding-left: 1.3;
    padding-right: 1.3;
    border-radius: 1.2;
    background-color: #16294a;
    cursor: pointer;
  }
  .button:hover { background-color: #1f3b63; }
  .button-text { font-size: 1.15; font-weight: 600; color: #e2e8f0; }
  .button-icon { width: 1.4; height: 1.4; color: #e2e8f0; }

  .root { width: 33; }
  .impact { flex-direction: row; gap: 0.6; flex-wrap: wrap; }
  .stat {
    flex-direction: column;
    gap: 0.1;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 0.9;
    padding-right: 0.9;
    border-radius: 1;
    background-color: #0f1b31;
  }
  .stat-value { font-size: 1.5; font-weight: 800; color: #f59e0b; }
  .stat-label { font-size: 0.8; font-weight: 700; color: #64748b; }
  .pick-row { flex-direction: row; align-items: center; gap: 0.7; }
  .pick-icon { width: 1.6; height: 1.6; color: #8ea3bf; }
  .pick-label { font-size: 0.95; font-weight: 800; color: #8ea3bf; }
  .pick { font-size: 1.55; font-weight: 700; color: #f1f5f9; }
  .pick-meta { font-size: 1.05; color: #8ea3bf; }
  .verdict { flex-direction: row; align-items: center; gap: 0.6; }
  .pill {
    font-size: 0.75;
    font-weight: 800;
    color: #052e16;
    background-color: #22c55e;
    padding-top: 0.12;
    padding-bottom: 0.12;
    padding-left: 0.45;
    padding-right: 0.45;
    border-radius: 0.5;
  }
  .verdict-text { font-size: 0.95; color: #cbd5e1; }
  .status { font-size: 1.05; color: #e2e8f0; }
  .actions { flex-direction: row; gap: 0.7; }
  .submit { background-color: #16a34a; }
  .submit:hover { background-color: #22c55e; }
</style>
<div class="root">
  <div class="header">
    <div class="badge"><Users class="badge-icon"></Users></div>
    <div class="heading">
      <div id="seat-eyebrow" class="eyebrow">SEAT TO COVER</div>
      <div id="seat-title" class="title">Choose a disruption</div>
    </div>
  </div>
  <div id="seat-sub" class="muted">Pick one on the left.</div>
  <div class="impact">
    <div class="stat"><div id="stat-flights" class="stat-value">0</div><div class="stat-label">FLIGHTS UNCREWED</div></div>
    <div class="stat"><div id="stat-pax" class="stat-value">0</div><div class="stat-label">PASSENGERS</div></div>
    <div class="stat"><div id="stat-out" class="stat-value">C-0000</div><div class="stat-label">CREW OUT</div></div>
  </div>
  <div class="divider"></div>
  <div class="pick-row">
    <ShieldCheck id="pick-icon" class="pick-icon"></ShieldCheck>
    <div id="pick-label" class="pick-label">THE ENGINE RECOMMENDS</div>
  </div>
  <div id="pick-name" class="pick">Loading</div>
  <div id="pick-meta" class="pick-meta">Loading</div>
  <div id="v-0" class="verdict">
    <div id="v-0-pill" class="pill">PASS</div>
    <div id="v-0-text" class="verdict-text">rule</div>
  </div>
  <div id="v-1" class="verdict">
    <div id="v-1-pill" class="pill">PASS</div>
    <div id="v-1-text" class="verdict-text">rule</div>
  </div>
  <div id="v-2" class="verdict">
    <div id="v-2-pill" class="pill">PASS</div>
    <div id="v-2-text" class="verdict-text">rule</div>
  </div>
  <div id="v-3" class="verdict">
    <div id="v-3-pill" class="pill">PASS</div>
    <div id="v-3-text" class="verdict-text">rule</div>
  </div>
  <div id="v-4" class="verdict">
    <div id="v-4-pill" class="pill">PASS</div>
    <div id="v-4-text" class="verdict-text">rule</div>
  </div>
  <div id="v-5" class="verdict">
    <div id="v-5-pill" class="pill">PASS</div>
    <div id="v-5-text" class="verdict-text">rule</div>
  </div>
  <div id="v-6" class="verdict">
    <div id="v-6-pill" class="pill">PASS</div>
    <div id="v-6-text" class="verdict-text">rule</div>
  </div>
  <div class="divider"></div>
  <div id="status-text" class="status">Loading</div>
  <div class="actions">
    <button id="submit-button" class="button submit"><Send class="button-icon"></Send><div id="submit-text" class="button-text">Submit for approval</div></button>
    <button id="reset-button" class="button"><RotateCcw class="button-icon"></RotateCcw><div id="reset-text" class="button-text">Recommended</div></button>
  </div>
</div>
